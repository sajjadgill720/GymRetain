# Application
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database (with connection pooling)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymretain?schema=public"

# Direct URL for Prisma migrations if using PgBouncer
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gymretain?schema=public"

# JWT Authentication
JWT_SECRET="gymretain-super-secure-jwt-secret-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# QR Code Verification Secret Key
QR_TOKEN_SECRET="gymretain-qr-signing-secret"

# Phase 2: WhatsApp (Twilio credentials - Mocked for Phase 1)
TWILIO_ACCOUNT_SID="mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Phase 3: Payments (JazzCash credentials - Mocked for Phase 1)
JAZZCASH_MERCHANT_ID="mock_jazzcash_merchant_id"
JAZZCASH_PASSWORD="mock_jazzcash_password"
JAZZCASH_INTEGRITY_SALT="mock_jazzcash_salt"
JAZZCASH_RETURN_URL="http://localhost:4000/api/v1/payments/jazzcash/callback"
